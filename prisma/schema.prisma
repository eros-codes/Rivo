generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  email        String    @unique
  bio          String?
  profilePics  String[]
  isOnline     Boolean   @default(false)
  lastSeen     DateTime?
  privacyOnline  String @default("everyone")
  privacyEmail   String @default("everyone")
  privacyProfile String @default("everyone")
  passwordChangedAt DateTime?
  passwordHash String
  createdAt    DateTime  @default(now())

  ownedContacts  Contact[] @relation("owner")
  contacts       Contact[] @relation("contact")
  messages       Message[]
  pushSubscriptions PushSubscription[]
  conversations  ConversationMember[]
  reactions      MessageReaction[]
}

model Contact {
  id             Int          @id @default(autoincrement())
  owner          User         @relation("owner", fields: [ownerId], references: [id])
  ownerId        Int
  contact        User         @relation("contact", fields: [contactId], references: [id])
  contactId      Int
  nickname       String?
  isPinned       Boolean      @default(false)
  pinOrder       Int?
  isMuted        Boolean      @default(false)
  isBlocked      Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isSaved        Boolean      @default(false)
  unreadCount    Int          @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  @@index([conversationId])
  @@index([ownerId])
}

model Conversation {
  id            Int                  @id @default(autoincrement())
  // Deterministic participants key (sorted user ids) to enforce a unique
  // conversation per participant set. Add a migration after this change.
  participantsKey String?            @unique
  createdAt     DateTime             @default(now())
  lastMessageAt DateTime?
  members       ConversationMember[]
  messages      Message[]
  contacts      Contact[]
}

model ConversationMember {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  @@index([conversationId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       Int
  // legacy plaintext (nullable during migration)
  text           String?
  // encrypted fields (DEK/KEK envelope encryption)
  ciphertext     String?
  iv             String?
  auth_tag       String?
  wrapped_dek    String?
  key_id         String?
  isSeen         Boolean      @default(false)
  isEdited       Boolean      @default(false)
  isPinned       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  isOneTime      Boolean      @default(false)
  isTimeCapsule  Boolean      @default(false)
  scheduledFor   DateTime?
  openedAt       DateTime?
  replyToId      Int?
  replyToName    String?
  replyToText    String?
  forwardedFrom  String?
  forwardedText  String?
  createdAt      DateTime     @default(now())
  reactions      MessageReaction[]
  @@index([conversationId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsed  DateTime?
  @@index([userId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}