generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  email        String    @unique
  bio          String?
  profilePics  String[]
  isOnline     Boolean   @default(false)
  lastSeen     DateTime?
  privacyOnline  String @default("everyone")
  privacyEmail   String @default("contacts")
  privacyProfile String @default("everyone")
  passwordChangedAt DateTime?
  isDeleted      Boolean  @default(false)
  passwordHash String
  createdAt    DateTime  @default(now())

  ownedContacts  Contact[] @relation("owner")
  contacts       Contact[] @relation("contact")
  messages       Message[]
  pushSubscriptions PushSubscription[]
  conversations  ConversationMember[]
  reactions      MessageReaction[]
  passwordResets PasswordResetToken[]
  sessions       Session[]
}

// One signed-in device. The session cookie carries a JWT that names it, so a
// device can be signed out on its own (and right away) by revoking its row.
model Session {
  id         String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?

  pushSubscriptions PushSubscription[]

  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Contact {
  id             Int          @id @default(autoincrement())
  owner          User         @relation("owner", fields: [ownerId], references: [id])
  ownerId        Int
  contact        User         @relation("contact", fields: [contactId], references: [id])
  contactId      Int
  nickname       String?
  isPinned       Boolean      @default(false)
  pinOrder       Int?
  isMuted        Boolean      @default(false)
  isBlocked      Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isSaved        Boolean      @default(false)
  // false for a row the server made on its own (the other person added this
  // user, or wrote after being removed) until the owner writes in the chat
  // or names the person: only then do they count as "my contacts" for the
  // privacy settings
  addedByOwner   Boolean      @default(true)
  unreadCount    Int          @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  // a person is in someone's list once; one Saved Messages per user (its
  // row names the owner themselves)
  @@unique([ownerId, contactId, isSaved])
  @@index([conversationId])
  @@index([ownerId])
}

model Conversation {
  id            Int                  @id @default(autoincrement())
  createdAt     DateTime             @default(now())
  lastMessageAt DateTime?
  members       ConversationMember[]
  messages      Message[]
  contacts      Contact[]
}

model ConversationMember {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  @@unique([conversationId, userId])
  @@index([conversationId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       Int
  // the text, encrypted (DEK/KEK envelope encryption: server/ENCRYPTION.md);
  // a deleted message keeps none of it
  ciphertext     String?
  iv             String?
  auth_tag       String?
  wrapped_dek    String?
  key_id         String?
  isSeen         Boolean      @default(false)
  isEdited       Boolean      @default(false)
  isPinned       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  isOneTime      Boolean      @default(false)
  isTimeCapsule  Boolean      @default(false)
  scheduledFor   DateTime?
  openedAt       DateTime?
  // id the sending device gave the message, so a retried send is stored once
  clientId       String?
  replyToId      Int?
  replyToName    String?
  // the quoted / forwarded text, sealed with this message's own DEK
  replyToText    String?
  forwardedFrom  String?
  forwardedText  String?
  createdAt      DateTime     @default(now())
  // every change (edit, delete, seen, pin, reaction, capsule opening) moves it,
  // so a client can ask for "what changed since" after being offline
  updatedAt      DateTime     @updatedAt
  reactions      MessageReaction[]
  @@unique([senderId, clientId])
  @@index([conversationId])
  // pages of a chat (newest first, by time then id)
  @@index([conversationId, createdAt, id])
  // the time-capsule job looks for due capsules every 30 seconds
  @@index([isTimeCapsule, scheduledFor])
  // changes of a chat since a moment (sync after a reconnect)
  @@index([conversationId, updatedAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  // the signed-in device it belongs to: signing that device out stops them
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsed  DateTime?
  @@index([userId])
  @@index([sessionId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}