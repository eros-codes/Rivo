# ============================================================================
# Rivo — نمونه‌ی متغیرهای محیطی
# این فایل را به .env کپی کنید و مقادیر بخش «ضروری» را پر کنید.
# بقیه‌ی مقادیر پیش‌فرض دارند و فقط برای تنظیم دقیق‌تر لازم‌اند.
# ============================================================================


# ─── ۱) ضروری — بدون این‌ها برنامه بالا نمی‌آید ──────────────────────────────

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rivo?schema=public"
JWT_SECRET=""                       # حداقل ۳۲ کاراکتر تصادفی
PORT=3000
NODE_ENV=development                # development | production
ALLOWED_ORIGINS="http://localhost:3000"   # چند مورد با کاما جدا شود


# ─── ۲) کلیدهای رمزنگاری (KEK) — بدون این‌ها پیام‌ها رمزگشایی نمی‌شوند ──────
# با `npm run gen-kek` ساخته می‌شوند. key_id هر پیام تعیین می‌کند
# از کدام نسخه استفاده شود، پس نسخه‌های قدیمی را هرگز حذف نکنید.

KEK_V1=""                           # کلید فعال فعلی (base64)
KEK_V2=""                           # نسخه‌ی بعدی، فقط هنگام چرخش کلید
ACTIVE_KEY_ID=v1                    # نسخه‌ی KEK برای پیام‌های جدید
KEK=""                              # فقط برای اسکریپت‌های تست؛ در اجرای عادی لازم نیست
ALLOW_EPHEMERAL_KEK=0               # 1 = ساخت کلید موقت هنگام اجرا (فقط توسعه‌ی محلی!)


# ─── ۳) مدیریت اسرار (Vault) — اختیاری ─────────────────────────────────────
# اگر SECRET_PROVIDER خالی باشد، کلیدها مستقیم از همین فایل خوانده می‌شوند.

SECRET_PROVIDER=""                  # "vault" یا خالی
VAULT_ADDR="http://127.0.0.1:8200"
VAULT_TOKEN=""
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=rivo
VAULT_CACHE_TTL=60                  # ثانیه

# سرور Vault ساختگی برای توسعه (npm run mock-vault)
MOCK_VAULT_PORT=8200
MOCK_VAULT_TOKEN=s.test


# ─── ۴) ایمیل (تایید حساب و بازیابی رمز) ───────────────────────────────────

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="support@rivo.ir"
APP_NAME=Rivo
RESET_TOKEN_TTL_MINUTES=30
APP_URL="http://localhost:3000"


# ─── ۵) نوتیفیکیشن مرورگر (Web Push) ───────────────────────────────────────
# با `node server/scripts/gen_vapid.js` ساخته می‌شوند.

VAPID_PUBLIC=""
VAPID_PRIVATE=""
VAPID_CONTACT="mailto:admin@example.com"
PUSH_SEND_CONCURRENCY=8             # تعداد ارسال هم‌زمان


# ─── ۶) احراز هویت و تایید ایمیل ───────────────────────────────────────────

BCRYPT_ROUNDS=12
VERIFICATION_TTL_MINUTES=10         # اعتبار کد تایید
VERIFICATION_MAX_ATTEMPTS=5         # سقف تلاش برای هر کد
VERIFICATION_SEND_LIMIT=5           # سقف ارسال در بازه‌ی زیر
VERIFICATION_SEND_WINDOW_MINUTES=60
MAX_VERIFICATION_STORE=10000        # سقف کدهای نگهداری‌شده در حافظه
MAX_VERIFIED_EMAILS=10000
MAX_SEND_COUNTS=20000


# ─── ۷) محدودیت نرخ ────────────────────────────────────────────────────────

ENABLE_HTTP_RATE_LIMITER=1
HTTP_RATE_WINDOW_MS=60000
HTTP_RATE_MAX=600                   # درخواست در هر بازه
AUTH_RATE_WINDOW_MINUTES=15
AUTH_RATE_MAX=10                    # تلاش ورود در هر بازه
ENABLE_TRUST_PROXY=0                # 1 = پشت nginx/Cloudflare (فقط در production اثر دارد)


# ─── ۸) سوکت و بلادرنگ ─────────────────────────────────────────────────────

SOCKET_PING_INTERVAL=5000
SOCKET_PING_TIMEOUT=5000
SOCKET_RATE_WINDOW_MS=10000
SOCKET_RATE_MAX=20                  # رویداد در هر بازه، برای هر اتصال
SOCKET_CONN_ATTEMPT_WINDOW_MS=60000
SOCKET_CONN_ATTEMPT_MAX=30
SOCKET_CONN_ATTEMPT_MAP_MAX=5000
SOCKET_CONN_ATTEMPT_STORE_MAX=100
OFFLINE_GRACE_MS=7000               # مهلت قبل از اعلام آفلاین‌شدن
TYPING_THROTTLE_MS=500


# ─── ۹) کش و اندازه‌ی دسته‌ها ───────────────────────────────────────────────

MEMBERSHIP_CACHE_TTL_MS=30000
MEMBERSHIP_CACHE_MAX=10000
RECIPIENTS_CACHE_TTL_MS=30000
RECIPIENTS_CACHE_MAX=5000
MESSAGE_SEEN_BATCH_SIZE=1000
MESSAGE_SEEN_MAX_COLLECT=10000
MESSAGE_SEEN_MAX_ITERATIONS=50
OPEN_CAPSULES_BATCH_SIZE=50         # کپسول‌های زمانی در هر اجرا


# ─── ۱۰) صفحه‌بندی ─────────────────────────────────────────────────────────

DEFAULT_PAGE_LIMIT=50
MAX_CLIENT_PAGE_LIMIT=100
DEFAULT_FETCH_LIMIT=50
MAX_FETCH_LIMIT=100
CONTACTS_DEFAULT_LIMIT=50
DEFAULT_CONVERSATIONS_TAKE=50
MAX_CONVERSATIONS_TAKE=100
CLIENT_PREFETCH_ON_OPEN=""          # تعداد پیام پیش‌بارگذاری هنگام باز کردن چت


# ─── ۱۱) اعتبارسنجی ورودی ──────────────────────────────────────────────────

MAX_MESSAGE_LENGTH=1500
MAX_NAME_LENGTH=255


# ─── ۱۲) پایش و اشکال‌زدایی ────────────────────────────────────────────────

SENTRY_DSN=""                       # خالی = غیرفعال
AVATAR_DEBUG=0                      # 1 = لاگ کامل پردازش آواتار
