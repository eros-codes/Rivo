# Rivo on a server: the settings to fill in (docs/DEPLOY.md → The settings).
#   cp deploy/env.production.example .env    then fill in the empty values
# Everything not here keeps its default (.env.example lists them all).
# The copy (.env) never goes to git (.gitignore): it holds the keys.

NODE_ENV=production
PORT=3000

# The site's address: links in emails, link previews, the one allowed origin
APP_URL="https://__DOMAIN__"
ALLOWED_ORIGINS="https://__DOMAIN__"
# Behind nginx: each client's own address comes from X-Forwarded-For.
# Without it every user has nginx's address, and they all share one rate limit.
ENABLE_TRUST_PROXY=1

# The database (docs/DEPLOY.md → The database)
DATABASE_URL="postgresql://rivo:DB_PASSWORD@localhost:5432/rivo?schema=public"

# openssl rand -hex 32
JWT_SECRET=""

# npm run gen-kek. Keep a copy somewhere OFF this server (a password manager):
# without it no message, and no backup, can ever be read again.
KEK_V1=""
ACTIVE_KEY_ID=v1

# npm run gen-vapid (it prints both lines)
VAPID_PUBLIC=""
VAPID_PRIVATE=""
VAPID_CONTACT="mailto:YOU@gmail.com"

# Email (sign-up codes, password reset): Gmail with an App Password
# (Google account → Security → 2-Step Verification on → App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="YOU@gmail.com"
SMTP_PASS=""
SMTP_FROM="Rivo <YOU@gmail.com>"
# The privacy page's contact address (empty: SMTP_FROM's)
CONTACT_EMAIL=""
