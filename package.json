{
  "name": "rivo",
  "version": "1.0.0",
  "type": "module",
  "description": "Conversations, uninterrupted",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/sw/tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/test.mjs all",
    "test:unit": "node scripts/test.mjs unit",
    "test:api": "node scripts/test.mjs api",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:integration": "node tests/integration/socket-flow.js",
    "db:check": "node server/scripts/check_duplicates.js",
    "db:seed": "node prisma/seed/index.js",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "mock-vault": "node server/scripts/mock_vault_server.js",
    "push-keks": "node server/scripts/push_keks_to_vault.js",
    "insert-test-message": "node server/scripts/insert_persistent_message.js",
    "rotate-keys": "node server/scripts/rotate_keys.js",
    "verify-rotation": "node server/scripts/verify_decrypted_after_rotation.js",
    "gen-kek": "node server/scripts/gen_kek.js",
    "test:enc": "node server/scripts/test_message_encryption.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^7.120.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "emoji-picker-element": "^1.29.1",
    "express": "^5.2.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.1.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.3",
    "prisma": "^6.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.32.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "braces": "^3.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
