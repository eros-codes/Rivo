# Node modules
node_modules/

# Environment files (ignore real secrets). Keep `.env.example` in the repo.
.env
.env.local
.env.*.local

# The database client, generated from prisma/schema.prisma (npm install / npx prisma generate)
/server/generated/

# Build output
dist/
build/
out/
# (the web clients, built by `npm run build` from client/)
/public/app/
/public/chat/
/public/auth/
/public/landing/
/public/404.html
/public/reset-password.html
/public/service-worker.js

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Tests (Playwright's report and failure artifacts; the load test's reports)
test-results/
playwright-report/
load-reports/

# Database backups (scripts/backup-db.sh): user data, never in git
backups/

# Coverage
coverage/
.nyc_output/

# Optional npm cache
.npm/

# TypeScript
*.tsbuildinfo

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Database dumps and temporary SQL files
*.dump
rivo-backup-*.dump
tmp_migs.sql

# Local secret stores / vaults
.vault/
secrets.json

# Uploaded profile pictures (the folder is created on the first upload)
/public/assets/images/user-profiles/*

# Pictures for the test data (npm run db:seed): yours, not the repo's
/prisma/seed/avatars/*
!/prisma/seed/avatars/README.md
