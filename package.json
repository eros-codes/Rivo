{
	"name": "rivo",
	"version": "1.0.0",
	"type": "module",
	"description": "Conversations, uninterrupted",
	"scripts": {
		"postinstall": "prisma generate",
		"check": "npm run typecheck && npm run lint && npm run build && npm test",
		"build": "node scripts/build.mjs",
		"dev": "node scripts/dev.mjs",
		"start": "node --import ./server/instrument.ts server/index.ts",
		"server": "nodemon --watch server --watch shared --watch .env --ext js,ts,json --exec \"node --import ./server/instrument.ts\" server/index.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p client/sw/tsconfig.json && tsc -p server/tsconfig.json && tsc -p tests/tsconfig.json && tsc -p tests/unit/tsconfig.json",
		"lint": "eslint .",
		"test": "node scripts/test.mjs all",
		"test:unit": "node scripts/test.mjs unit",
		"test:api": "node scripts/test.mjs api",
		"test:e2e": "node scripts/test.mjs e2e",
		"loadtest": "node scripts/test.mjs load",
		"test:integration": "node tests/integration/socket-flow.ts",
		"db:check": "node server/scripts/check_duplicates.ts",
		"db:seed": "node prisma/seed/index.ts",
		"db:backup": "bash scripts/backup-db.sh",
		"db:restore": "bash scripts/restore-db.sh",
		"gen-kek": "node server/scripts/gen_kek.ts",
		"check-kek": "node server/scripts/check_kek.ts",
		"gen-vapid": "node server/scripts/gen_vapid.ts",
		"check-vapid": "node server/scripts/check_vapid.ts",
		"rotate-keys": "node server/scripts/rotate_keys.ts",
		"verify-messages": "node server/scripts/verify_messages.ts",
		"test:enc": "node server/scripts/test_message_encryption.ts",
		"insert-test-message": "node server/scripts/insert_test_message.ts",
		"mock-vault": "node server/scripts/mock_vault_server.ts",
		"push-keks": "node server/scripts/push_keks_to_vault.ts"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.0",
		"@prisma/client": "^7.9.0",
		"@sentry/node": "^11.4.0",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.5",
		"emoji-picker-element": "^1.29.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.1.1",
		"nodemailer": "^10.0.15",
		"prisma": "^7.9.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sharp": "^0.35.5",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"web-push": "^3.5.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@playwright/test": "^1.56.0",
		"@types/bcrypt": "^5.0.0",
		"@types/cookie-parser": "^1.4.0",
		"@types/cors": "^2.8.0",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.0",
		"@types/multer": "^1.4.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/web-push": "^3.6.0",
		"esbuild": "^0.28.0",
		"eslint": "^10.1.0",
		"nodemon": "^3.1.14",
		"tsx": "^4.20.0",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"uuid": "^14.0.0",
		"braces": "^3.0.3"
	},
	"engines": {
		"node": ">=22.18"
	},
	"allowScripts": {
		"bcrypt": true,
		"esbuild": true,
		"prisma@7.10.0": true,
		"@prisma/engines@7.10.0": true
	}
}