# Database connection string example (replace with your values at runtime):
# DATABASE_URL="postgresql://user:password@localhost:5432/rivo"
DATABASE_URL=
JWT_SECRET="replace_this_with_a_strong_random_secret"
PORT=3000
# Key encryption key (KEK) - required for message encryption
# Generate a 32-byte KEK (base64) with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEK_V1=

# Comma-separated list of allowed origins for CORS and socket.io
# e.g. http://localhost:3000,http://127.0.0.1:3000,https://rivo.ir
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://rivo.ir,https://www.rivo.ir,https://chat.rivo.ir

