# ============================================================================
# Rivo — example environment variables
# Copy this file to .env and fill in the "Required" section.
# Everything else has a default and is only needed for finer tuning.
# ============================================================================


# ─── 1) Required — the server does not start without these ─────────────────

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rivo?schema=public"
                                    # (the server and the prisma command both read it: prisma.config.ts)
JWT_SECRET=""                       # at least 32 random characters
PORT=3000
NODE_ENV=development                # development | production
ALLOWED_ORIGINS="http://localhost:3000"   # several, separated by commas


# ─── 2) Encryption keys (KEK) — without them messages cannot be decrypted ──
# Made with `npm run gen-kek` and checked with `npm run check-kek`.
# Each message's key_id says which version decrypts it, so never change or
# delete a key (key rotation: server/ENCRYPTION.md).

KEK_V1=""                           # the current active key (base64)
KEK_V2=""                           # the next version, only during key rotation
ACTIVE_KEY_ID=v1                    # which KEK version new messages use
ALLOW_EPHEMERAL_KEK=0               # 1 = make a temporary key at startup (local development only!)


# ─── 3) Secrets management (Vault) — optional ──────────────────────────────
# With SECRET_PROVIDER empty, the keys are read from this file.

SECRET_PROVIDER=""                  # "vault" or empty
VAULT_ADDR="http://127.0.0.1:8200"
VAULT_TOKEN=""
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=rivo
VAULT_CACHE_TTL=60                  # seconds

# A stand-in Vault server for development (npm run mock-vault)
MOCK_VAULT_PORT=8200
MOCK_VAULT_TOKEN=s.test


# ─── 4) Email (account verification and password reset) ───────────────────

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="support@rivo.ir"
APP_NAME=Rivo
RESET_TOKEN_TTL_MINUTES=30
APP_URL="http://localhost:3000"     # the site's address, for the links in emails (e.g. https://chat.rivo.ir)


# ─── 5) Browser notifications (Web Push) ───────────────────────────────────
# Made with `npm run gen-vapid` (once per server); `npm run check-vapid` checks them.

VAPID_PUBLIC=""
VAPID_PRIVATE=""
VAPID_CONTACT="mailto:admin@example.com"
PUSH_SEND_CONCURRENCY=8             # how many are sent at the same time
PUSH_TTL_SECONDS=86400              # how long the push service keeps one for a device that is off
PUSH_MAX_PER_USER=20                # push subscriptions per account at most (the oldest are removed)
PUSH_ALLOWED_HOSTS=""               # more push hosts, separated by commas (the major browsers' services are allowed already)


# ─── 6) Authentication and email verification ──────────────────────────────

BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=30                 # a device is signed out after this long unused (every use extends it)
VERIFICATION_TTL_MINUTES=10         # how long a verification code is valid
VERIFICATION_MAX_ATTEMPTS=5         # tries per code at most
VERIFICATION_SEND_LIMIT=5           # codes sent at most within the window below
VERIFICATION_SEND_WINDOW_MINUTES=60
MAX_SEND_COUNTS=20000               # at most this many send counters kept in memory


# ─── 7) Rate limits ────────────────────────────────────────────────────────

ENABLE_HTTP_RATE_LIMITER=1
HTTP_RATE_WINDOW_MS=60000
HTTP_RATE_MAX=600                   # requests per window
AUTH_RATE_WINDOW_MINUTES=15
AUTH_RATE_MAX=10                    # *failed* sign-in / code attempts per window (per address and account)
ENABLE_TRUST_PROXY=0                # 1 = behind nginx/Cloudflare (production only). Needed there: without it
                                    # every user has the proxy's address, and they all share one rate limit


# ─── 8) Live connection (Socket.IO) ────────────────────────────────────────

SOCKET_PING_INTERVAL=5000
SOCKET_PING_TIMEOUT=5000
SOCKET_RATE_WINDOW_MS=10000
SOCKET_RATE_MAX=20                  # each user's budget of actions per window (send, edit, delete, …; shared by the socket and REST)
SOCKET_CONN_ATTEMPT_WINDOW_MS=60000
SOCKET_CONN_ATTEMPT_MAX=30
SOCKET_CONN_ATTEMPT_MAP_MAX=5000
SOCKET_CONN_ATTEMPT_STORE_MAX=100
OFFLINE_GRACE_MS=7000               # how long before someone is shown as offline
TYPING_THROTTLE_MS=500


# ─── 9) Caches and batch sizes ─────────────────────────────────────────────

MEMBERSHIP_CACHE_TTL_MS=30000
MEMBERSHIP_CACHE_MAX=10000
RECIPIENTS_CACHE_TTL_MS=30000
RECIPIENTS_CACHE_MAX=5000
OPEN_CAPSULES_BATCH_SIZE=50         # time capsules opened per run
DATABASE_POOL_MAX=10                # connections to PostgreSQL at most (replaces the old connection_limit in the URL)


# ─── 10) Paging ────────────────────────────────────────────────────────────

DEFAULT_FETCH_LIMIT=50
MAX_FETCH_LIMIT=100
CONTACTS_DEFAULT_LIMIT=50
SEARCH_MAX_PER_MINUTE=40            # message searches per minute per user
SEARCH_MAX_SCAN=5000                # messages one search looks through at most


# ─── 11) Input validation ──────────────────────────────────────────────────
# The lengths of a message, name, bio and password are not settings: the app and
# the server must agree on them, so they live in shared/limits.ts. Every input
# is checked with the schemas in shared/schemas.


# ─── 12) Monitoring and debugging ──────────────────────────────────────────

SENTRY_DSN=""                       # server errors only; empty = off (with npm start; docs → Error reporting)
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=""                       # json | pretty; empty = json in production, readable in development
APP_VERSION=""                      # shown in /api/health and the startup log; empty = package.json's version


# ─── 13) Backups (scripts/backup-db.sh and restore-db.sh) ──────────────────

BACKUP_DIR=backups                  # where; keep a copy somewhere else too
BACKUP_KEEP_DAYS=14                 # older backups are deleted
RESTORE_DATABASE_URL=""             # a separate database for restore drills (e.g. .../rivo_restore_test)


# ─── 14) Tests (on a development machine only, not on the server) ──────────

# A database only for tests; its name must contain "test". The tests write to it.
TEST_DATABASE_URL=""                # e.g. postgresql://USER:PASSWORD@localhost:5432/rivo_test
# (The tests set MAIL_CAPTURE_FILE themselves; the server refuses to start with it in production.
# The browser tests' options, such as E2E_CHANNEL, go on the command line: docs → Tests.)
